# Render.com ignore file
# Files and directories to ignore during deployment

# Development files
.env.local
.env.development
*.log
logs/

# Node.js files (if any)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Test files
.pytest_cache/
.coverage
htmlcov/

# Documentation
docs/
*.md
README*

# Git files
.git/
.gitignore